7.3.102.1.in-addr.arpa.	IN	PTR	r3-eth2.isp102.lab.
8.3.102.1.in-addr.arpa.	IN	PTR	r3-eth3.isp102.lab.
3.4.102.1.in-addr.arpa.	IN	PTR	r3-lo.isp102.lab.

1.2.102.1.in-addr.arpa.	IN	PTR	r4-eth0.isp102.lab.
4.3.102.1.in-addr.arpa.	IN	PTR	r4-eth1.isp102.lab.
