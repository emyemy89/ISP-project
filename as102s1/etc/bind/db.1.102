2.1.102.1.in-addr.arpa.	IN	PTR	ns.isp102.lab.
3.1.102.1.in-addr.arpa.	IN	PTR	www.isp102.lab.
4.1.102.1.in-addr.arpa.	IN	PTR	dhcpd.isp102.lab.

10.2.102.1.in-addr.arpa.	IN	PTR	c1.isp102.lab.
